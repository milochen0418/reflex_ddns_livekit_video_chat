# Every setting here is OPTIONAL.
# With none of them set, the app starts its own open-source LiveKit server
# (https://github.com/livekit/livekit) and generates its API key/secret.

# Admin passcode for /settings (API key/secret, media IP override, restart, log).
# Leave empty and /settings only shows the server status.
ADMIN_PASSCODE=

# IP address browsers send video and audio to (LiveKit rtc.node_ip).
# Behind re-ddns it comes automatically from EXTERNAL_IP (the Docker host's LAN IP).
# LIVEKIT_NODE_IP=

# Fixed API key/secret, e.g. to share this server with other apps.
# The secret must be at least 32 characters.
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Ports. In Docker, publish the media ports on the host: TCP 7981 and UDP 7982.
# (100 above the audio chat app's 7880-7882, so both apps can share a host.)
# LIVEKIT_PORT=7980
# LIVEKIT_RTC_TCP_PORT=7981
# LIVEKIT_RTC_UDP_PORT=7982

# livekit-server binary. Linux downloads this release from GitHub on first start;
# macOS uses the one on PATH (brew install livekit).
# LIVEKIT_SERVER_BIN=
# LIVEKIT_SERVER_VERSION=1.13.7

# Directory for runtime files (binary, keys, config, server log).
# LIVEKIT_HOME=

# LiveKit URL handed to browsers (default: this app's own backend URL, which relays /rtc).
# LIVEKIT_PUBLIC_URL=
